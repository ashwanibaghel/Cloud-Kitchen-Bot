# WhatsApp Cloud API
WHATSAPP_PHONE_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_TOKEN=YOUR_LONG_LIVED_TOKEN
WHATSAPP_VERIFY_TOKEN=cloudkitchenverify
WA_API_VERSION=v22.0

# Live video fallback page
LIVE_VIDEO_BASE_URL=https://your-domain.com/live

# Admin alerts (comma-separated, country code ke saath)
ADMIN_NUMBERS=91XXXXXXXXXX,91YYYYYYYYYY

# Session
SESSION_TIMEOUT_MINUTES=30