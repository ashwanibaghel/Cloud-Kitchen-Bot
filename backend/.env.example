# WhatsApp Cloud API
WHATSAPP_TOKEN=your_whatsapp_api_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# Firebase Admin SDK
FIREBASE_PROJECT_ID=cloud-kitchen-bot
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@cloud-kitchen-bot.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Razorpay (if used)
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Other
PORT=3000
SESSION_TIMEOUT_MINUTES=30
